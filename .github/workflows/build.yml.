name: Build APK
on:
  push:
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: unzip Signal4G.zip
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 8.7
      - run: gradle assembleDebug
        working-directory: Signal4G
      - uses: actions/upload-artifact@v4
        with:
          name: Signal4G-apk
          path: Signal4G/app/build/outputs/apk/debug/app-debug.apk
